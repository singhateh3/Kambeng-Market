APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Minutes until an issued Sanctum bearer token expires. 43200 = 30 days.
SANCTUM_TOKEN_EXPIRATION=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ModemPay — sole payment provider. Get these from the Modem Pay dashboard;
# use sk_test_... during development, sk_live_... only in production.
MODEMPAY_SECRET_KEY=
MODEMPAY_WEBHOOK_SECRET=
# MODEMPAY_BASE_URL=https://api.modempay.com

# Platform commission taken from every successful order (3% = 0.03).
# COMMISSION_RATE=0.03
# Days after delivery before an unconfirmed, undisputed order's farmer
# payout auto-releases.
# COMMISSION_AUTO_RELEASE_DAYS=3
# Minutes an order may sit awaiting payment before the checkout expires.
# AWAITING_PAYMENT_TIMEOUT_MINUTES=30

# Google Sign-In — OAuth 2.0 Web Client ID from Google Cloud Console. Not
# secret; also exposed to the frontend as VITE_GOOGLE_CLIENT_ID, but used
# here server-side to verify an identity token's audience.
GOOGLE_CLIENT_ID=

# Apple Sign-In — Services ID is the web "client id" registered in the
# Apple Developer portal, used the same way as GOOGLE_CLIENT_ID above (also
# exposed to the frontend as VITE_APPLE_SERVICES_ID). team_id/key_id/
# private_key are only needed for a future server-initiated Apple flow
# (not the one currently implemented) — private_key must NEVER be exposed
# to the frontend.
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
